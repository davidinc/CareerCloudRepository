# CareerCloud Azure Deployment Configuration
# Copy this file to .env and fill in your values

# Environment name (dev, staging, prod)
ENVIRONMENT=dev

# Azure Settings
AZURE_LOCATION=East US
AZURE_SUBSCRIPTION_ID=your-subscription-id

# Resource Names (auto-generated if left empty)
RESOURCE_GROUP=rg-careercloud-dev
WEB_APP_NAME=
SQL_SERVER_NAME=
SQL_DATABASE_NAME=careercloud-db

# SQL Database Credentials
# ⚠️  IMPORTANT: Change these to strong, secure values!
SQL_ADMIN_USERNAME=sqladmin
SQL_ADMIN_PASSWORD=ChangeMe@12345

# App Service Plan SKU
# Options: B1, B2, B3, S1, S2, S3, P1V2, P2V2
APP_SERVICE_PLAN_SKU=B1

# SQL Database SKU
# Options: Basic, Standard (S0-S12), Premium (P1-P15)
SQL_DATABASE_SKU=Basic

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
LOG_LEVEL=Information

# Database Connection
# This will be auto-generated from SQL settings
DATABASE_CONNECTION_STRING=

# Application Insights (auto-created)
ENABLE_APP_INSIGHTS=true

# Key Vault (optional)
ENABLE_KEY_VAULT=false
KEY_VAULT_NAME=

# Tags for resources
PROJECT_TAG=CareerCloud
DEPLOYED_BY_TAG=AzureCLI
